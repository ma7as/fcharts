      "title": "Cache hit ratio (by namespace)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (namespace) (rate(cache_hits_total[5m])) / clamp_min(sum by (namespace) (rate(cache_hits_total[5m])) + sum by (namespace) (rate(cache_misses_total[5m])), 1)",
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
