// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Market data models
model Symbol {
  id               String   @id @default(cuid())
  symbol           String   @unique // e.g., "BTCUSDT", "AAPL", "GGAL", "AAPL.BA"
  name             String   // e.g., "Bitcoin", "Apple Inc", "Grupo Financiero Galicia"
  exchange         String   // e.g., "Binance", "NYSE", "NASDAQ", "BYMA"
  type             String   // "crypto" | "stock" | "cedear" | "cedear_underlying" | "etf" | "bond" | "index"
  sector           String?  // For stocks: "Technology", "Finance", etc.
  currency         String   @default("USD") // "USD" | "ARS" | "USDT"
  market           String   @default("GLOBAL") // "BYMA" | "NASDAQ" | "NYSE" | "Binance" | "GLOBAL"
  dataSource       String   @default("binance") // "binance" | "yahoo" | "alphavantage" | "finnhub" | "iol"
  underlyingSymbol String?  // Solo CEDEARs: ticker del subyacente en USD, ej: "AAPL"
  cedearRatio      Float?   // Solo CEDEARs: ratio de conversión, ej: 10.0
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  candles       Candle[]
  watchlists    WatchlistItem[]
  positions     Position[]
  transactions  Transaction[]

  @@index([symbol, exchange])
  @@index([type])
  @@index([market, type])
  @@map("symbols")
}

model Candle {
  id          String   @id @default(cuid())
  symbolId    String
  symbol      Symbol   @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  
  interval    String   // e.g., "1m", "5m", "15m", "1h", "4h", "1d"
  timestamp   DateTime // Opening time of the candle
  
  open        Decimal  @db.Decimal(20, 8)
  high        Decimal  @db.Decimal(20, 8)
  low         Decimal  @db.Decimal(20, 8)
  close       Decimal  @db.Decimal(20, 8)
  volume      Decimal  @db.Decimal(20, 8)
  
  createdAt   DateTime @default(now())

  @@unique([symbolId, interval, timestamp])
  @@index([symbolId, interval, timestamp])
  @@map("candles")
}

// User models (opcional para futuras features)
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  username    String   @unique
  password    String
  firstName   String?
  lastName    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  watchlists    Watchlist[]
  portfolios    Portfolio[]
  refreshTokens RefreshToken[]

  @@map("users")
}

/// Persistent refresh-token store. Tokens are stored as SHA-256 hashes,
/// not plaintext, so a DB leak cannot be used to forge sessions.
///
/// Rotation: each /api/v1/auth/refresh call marks the old row as `usedAt`
/// and issues a new row with the same `family`. Reuse of a used row
/// invalidates the entire family — defence in depth against token theft.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // SHA-256 of the opaque refresh token
  family    String    // Group id shared by every refresh issued from one login
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Watchlist {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       WatchlistItem[]

  @@index([userId])
  @@map("watchlists")
}

model WatchlistItem {
  id           String     @id @default(cuid())
  watchlistId  String
  watchlist    Watchlist  @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  symbolId     String
  symbol       Symbol     @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  position     Int        @default(0)
  createdAt    DateTime   @default(now())

  @@unique([watchlistId, symbolId])
  @@index([watchlistId])
  @@map("watchlist_items")
}
// Portfolio & Investment models
model Portfolio {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  currency    String   @default("USD") // Base currency for portfolio
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  positions        Position[]
  transactions     Transaction[]
  performanceSnaps PerformanceSnapshot[]

  @@index([userId])
  @@map("portfolios")
}

model Position {
  id              String    @id @default(cuid())
  portfolioId     String
  portfolio       Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  symbolId        String
  symbol          Symbol    @relation(fields: [symbolId], references: [id], onDelete: Restrict)
  
  quantity        Decimal   @db.Decimal(20, 8) // Current quantity held
  averagePrice    Decimal   @db.Decimal(20, 8) // Average purchase price
  currentPrice    Decimal?  @db.Decimal(20, 8) // Last known market price
  costBasis       Decimal   @db.Decimal(20, 2) // Total cost invested
  marketValue     Decimal?  @db.Decimal(20, 2) // Current market value
  unrealizedPnL   Decimal?  @db.Decimal(20, 2) // Unrealized profit/loss
  unrealizedPnLPct Decimal?  @db.Decimal(10, 4) // Unrealized P&L percentage
  
  lastUpdated     DateTime  @default(now())
  createdAt       DateTime  @default(now())

  @@unique([portfolioId, symbolId])
  @@index([portfolioId])
  @@map("positions")
}

model Transaction {
  id              String    @id @default(cuid())
  portfolioId     String
  portfolio       Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  symbolId        String
  symbol          Symbol    @relation(fields: [symbolId], references: [id], onDelete: Restrict)
  
  type            String    // "BUY", "SELL", "DIVIDEND", "SPLIT", "TRANSFER_IN", "TRANSFER_OUT"
  quantity        Decimal   @db.Decimal(20, 8)
  price           Decimal   @db.Decimal(20, 8)
  fees            Decimal   @default(0) @db.Decimal(20, 2)
  total           Decimal   @db.Decimal(20, 2) // Total amount (quantity * price + fees)
  
  notes           String?
  executedAt      DateTime  @default(now()) // When the transaction occurred
  createdAt       DateTime  @default(now())

  @@index([portfolioId])
  @@index([symbolId])
  @@index([executedAt])
  @@map("transactions")
}

model PerformanceSnapshot {
  id              String    @id @default(cuid())
  portfolioId     String
  portfolio       Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  
  timestamp       DateTime  @default(now())
  totalValue      Decimal   @db.Decimal(20, 2) // Total portfolio value
  totalCost       Decimal   @db.Decimal(20, 2) // Total cost basis
  totalPnL        Decimal   @db.Decimal(20, 2) // Total profit/loss
  totalPnLPct     Decimal   @db.Decimal(10, 4) // Total P&L percentage
  
  dayChange       Decimal?  @db.Decimal(20, 2) // Change since yesterday
  dayChangePct    Decimal?  @db.Decimal(10, 4) // Day change percentage
  
  cashBalance     Decimal   @default(0) @db.Decimal(20, 2) // Available cash

  @@index([portfolioId, timestamp])
  @@map("performance_snapshots")
}